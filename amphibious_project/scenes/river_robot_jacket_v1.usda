#usda 1.0
(
    customLayerData = {
        string owner = "L17"
        string target_config = "configs/jacket_target_v1.json"
    }
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
    subLayers = [
        @river_robot_v1.usda@
    ]
)

over "World"
{
    def Xform "NavigationTargets"
    {
        def Xform "Jacket" (
            customData = {
                dictionary navigation = {
                    string targetId = "jacket_inspection"
                }
            }
            prepend references = @../assets/targets/jacket_4leg_v1.usda@
        )
        {
            double3 xformOp:translate = (12, -23, 1.0118310640428256)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def "Materials"
        {
            def Material "Concrete" (
                prepend apiSchemas = ["PhysicsMaterialAPI"]
            )
            {
                token outputs:surface.connect = </World/NavigationTargets/Materials/Concrete/Surface.outputs:surface>
                float physics:dynamicFriction = 0.6
                float physics:restitution = 0
                float physics:staticFriction = 0.6

                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.35, 0.37, 0.36)
                    float inputs:metallic = 0.15
                    float inputs:roughness = 0.85
                    token outputs:surface
                }
            }
        }

        def "JacketFoundations"
        {
            def Cube "Pedestal_0" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                rel material:binding = </World/NavigationTargets/Materials/Concrete>
                rel material:binding:physics = </World/NavigationTargets/Materials/Concrete>
                double size = 1
                float3 xformOp:scale = (0.68, 0.68, 0.29274833)
                double3 xformOp:translate = (10.2, -24.8, 0.8654568954890545)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Cube "Pedestal_1" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                rel material:binding = </World/NavigationTargets/Materials/Concrete>
                rel material:binding:physics = </World/NavigationTargets/Materials/Concrete>
                double size = 1
                float3 xformOp:scale = (0.68, 0.68, 0.24710965)
                double3 xformOp:translate = (13.8, -24.8, 0.8882762361562877)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Cube "Pedestal_2" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                rel material:binding = </World/NavigationTargets/Materials/Concrete>
                rel material:binding:physics = </World/NavigationTargets/Materials/Concrete>
                double size = 1
                float3 xformOp:scale = (0.68, 0.68, 0.20611921)
                double3 xformOp:translate = (13.8, -21.2, 0.9087714626628216)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Cube "Pedestal_3" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                rel material:binding = </World/NavigationTargets/Materials/Concrete>
                rel material:binding:physics = </World/NavigationTargets/Materials/Concrete>
                double size = 1
                float3 xformOp:scale = (0.68, 0.68, 0.25525162)
                double3 xformOp:translate = (10.2, -21.2, 0.8842052496262107)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }

        def Xform "ApproachGoal" (
            customData = {
                bool evaluator_only = 1
                double radius_m = 0.6
            }
        )
        {
            float xformOp:rotateZ = 0
            double3 xformOp:translate = (8.2, -23, 0.8487257468844835)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
        }
    }

    over "Vegetation"
    {
        over "Tree_130" (
            active = false
        )
        {
        }
    }

    over "TaskMarkers"
    {
        over "Start"
        {
            token visibility = "invisible"
        }

        over "Goal"
        {
            token visibility = "invisible"
        }
    }

    over "Robot"
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (-12, -23, 1.2411919833341352)
    }

    over "Cameras"
    {
        def Camera "Target"
        {
            float2 clippingRange = (0.03, 250)
            float focalLength = 32
            float horizontalAperture = 36
            float verticalAperture = 20.25
            matrix4d xformOp:transform = ( (0.7739572992033211, -0.6332377902572628, 2.7755575615628926e-17, 0), (0.1868110704345185, 0.22832464164218932, 0.9554943652277996, 0), (-0.6050551404401175, -0.7395118383156994, 0.29500935242450327, 0), (2.999999999999996, -34, 8.700000000000001, 1.0000000000000002) )
            uniform token[] xformOpOrder = ["xformOp:transform"]
        }

        over "Crossing"
        {
            float2 clippingRange = (0.03, 250)
            float focalLength = 29
            float horizontalAperture = 36
            float verticalAperture = 20.25
            matrix4d xformOp:transform = ( (0.7432941462471664, -0.6689647316224497, -2.775557561562892e-17, 0), (0.3603011497682498, 0.4003346108536109, 0.8425647042384137, 0), (-0.563646071245399, -0.6262734124948877, 0.5385951347456034, 0), (-17.999999999999996, -41.99999999999999, 19, 1) )
        }

        over "Robot"
        {
            float2 clippingRange = (0.03, 250)
            float focalLength = 35
            float horizontalAperture = 36
            float verticalAperture = 20.25
            matrix4d xformOp:transform = ( (0.7649111981170507, -0.6441357457827799, 0, 0), (0.2384825118598374, 0.28319798283355674, 0.9289375619792899, 0), (-0.5983618892711672, -0.7105547435095106, 0.37023641898653487, 0), (-13.600000000000003, -24.900000000000002, 2.2911919833341376, 1) )
        }
    }
}

