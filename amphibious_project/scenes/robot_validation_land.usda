#usda 1.0
(
    customLayerData = {
        string creator = "L17"
        string validation_kind = "land"
        bool water_dynamics_requires_runtime = 1
    }
    defaultPrim = "World"
    endTimeCode = 36000
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 60
    upAxis = "Z"
)

def Xform "World"
{
    def PhysicsScene "PhysicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
        uniform token physxScene:broadphaseType = "MBP"
        bool physxScene:enableGPUDynamics = 0
        uint physxScene:timeStepsPerSecond = 120
    }

    def Scope "Looks"
    {
        def Material "Ground" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </World/Looks/Ground/Surface.outputs:surface>
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0
            float physics:staticFriction = 0.8

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.37, 0.39, 0.33)
                float inputs:metallic = 0.15
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "Water" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </World/Looks/Water/Surface.outputs:surface>
            float physics:dynamicFriction = 0
            float physics:restitution = 0
            float physics:staticFriction = 0

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.03, 0.29, 0.36)
                float inputs:metallic = 0.15
                float inputs:opacity = 0.8
                float inputs:roughness = 0.14
                token outputs:surface
            }
        }
    }

    def Cube "Ground" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </World/Looks/Ground>
        rel material:binding:physics = </World/Looks/Ground>
        double size = 1
        float3 xformOp:scale = (32, 24, 0.5)
        double3 xformOp:translate = (0, 0, -0.25)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Xform "Robot" (
        prepend references = @../robots/tracked_twin_thruster_v1.usda@
    )
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (-4, 0, 0.75)
    }

    def DomeLight "Sky"
    {
        float inputs:intensity = 400
    }

    def DistantLight "Sun"
    {
        float inputs:intensity = 1800
        float3 xformOp:rotateXYZ = (-40, -20, -35)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def "Cameras"
    {
        def Camera "Overview"
        {
            float2 clippingRange = (0.03, 250)
            float focalLength = 28
            float horizontalAperture = 36
            float verticalAperture = 20.25
            matrix4d xformOp:transform = ( (0.8221921916437785, 0.5692099788303082, 2.7755575615628914e-17, 0), (-0.28393289715606623, 0.4101252958920956, 0.8667060352749274, -0), (0.4933377239909419, -0.7125989346535827, 0.49881925425750784, 0), (8.999999999999998, -12.999999999999998, 8.999999999999998, 0.9999999999999999) )
            uniform token[] xformOpOrder = ["xformOp:transform"]
        }

        def Camera "Robot"
        {
            float2 clippingRange = (0.03, 250)
            float focalLength = 28
            float horizontalAperture = 36
            float verticalAperture = 20.25
            matrix4d xformOp:transform = ( (0.7709617516270894, -0.6368814469962913, -2.77555756156289e-17, 0), (0.2705650652021285, 0.32752613156047117, 0.9052740903379486, 0), (-0.5765522725826843, -0.6979316983895649, 0.42482799032408297, 0), (-5.8999999999999995, -2.3, 1.4999999999999998, 0.9999999999999998) )
            uniform token[] xformOpOrder = ["xformOp:transform"]
        }
    }
}

