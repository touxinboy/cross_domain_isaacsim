            customData = {
                bool evaluator_only = 1
                string medium = "water"
                double radius_m = 0.6
            }
        )
        {
            float xformOp:rotateZ = 92.46114
            double3 xformOp:translate = (-2.009832885981787, -17, 0.0354)
