#usda 1.0
(
    defaultPrim = "Jacket"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Jacket" (
    prepend apiSchemas = ["SemanticsAPI:Semantics"]
    customData = {
        dictionary navigation = {
            string shape = "pointed_mast"
        }
    }
    doc = "Orange fixed water jacket with yellow railing and a red pointed lattice mast."
)
{
    string semantic:Semantics:params:semanticData = "jacket_structure"
    string semantic:Semantics:params:semanticType = "class"

    def "Materials"
    {
        def Material "Orange" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Jacket/Materials/Orange/Surface.outputs:surface>
            float physics:dynamicFriction = 0.6
            float physics:restitution = 0
            float physics:staticFriction = 0.6

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.2, 0.025)
                float inputs:metallic = 0.15
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }

        def Material "OrangeBrace" (
