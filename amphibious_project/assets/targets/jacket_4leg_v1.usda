#usda 1.0
(
    customLayerData = {
        string owner = "L17"
        string scope = "Static collision-enabled navigation target; not an engineering or hydrodynamic jacket model."
        string target_id = "jacket_inspection"
    }
    defaultPrim = "Jacket"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Jacket" (
    prepend apiSchemas = ["SemanticsAPI:Semantics"]
    doc = "Static collision-enabled navigation target; not an engineering or hydrodynamic jacket model."
)
{
