    string semantic:Semantics:params:semanticType = "class"

    def "Materials"
    {
        def Material "YellowSteel" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Jacket/Materials/YellowSteel/Surface.outputs:surface>
            float physics:dynamicFriction = 0.6
            float physics:restitution = 0
            float physics:staticFriction = 0.6

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.93, 0.56, 0.035)
                float inputs:metallic = 0.15
                float inputs:roughness = 0.32
                token outputs:surface
            }
        }

        def Material "Braces" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Jacket/Materials/Braces/Surface.outputs:surface>
