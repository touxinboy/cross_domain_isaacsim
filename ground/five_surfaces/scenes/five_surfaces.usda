#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
    timeCodesPerSecond = 60
    startTimeCode = 0
    endTimeCode = 36000
    customLayerData = { string purpose = "L17 five-surface rigid baseline; no soil model changes" }
)
def Xform "World"
{
    def PhysicsScene "PhysicsScene" (prepend apiSchemas = ["PhysxSceneAPI"])
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
        uint physxScene:timeStepsPerSecond = 120
        bool physxScene:enableGPUDynamics = false
        token physxScene:broadphaseType = "MBP"
    }
    def Scope "Materials" { 
        def Material "Grass" (prepend apiSchemas = ["PhysicsMaterialAPI"])
        {
            float physics:staticFriction = 0.95
            float physics:dynamicFriction = 0.75
            float physics:restitution = 0.0
            token outputs:surface.connect = </World/Materials/Grass/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.29, 0.37, 0.19)
                float inputs:roughness = 0.9
                float inputs:metallic = 0
                token outputs:surface
            }
        }

        def Material "DrySand" (prepend apiSchemas = ["PhysicsMaterialAPI"])
        {
            float physics:staticFriction = 0.75
            float physics:dynamicFriction = 0.55
            float physics:restitution = 0.0
            token outputs:surface.connect = </World/Materials/DrySand/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.48, 0.31)
                float inputs:roughness = 0.9
                float inputs:metallic = 0
                token outputs:surface
            }
        }

        def Material "WetSand" (prepend apiSchemas = ["PhysicsMaterialAPI"])
        {
            float physics:staticFriction = 0.65
            float physics:dynamicFriction = 0.45
            float physics:restitution = 0.0
            token outputs:surface.connect = </World/Materials/WetSand/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.36, 0.32, 0.21)
                float inputs:roughness = 0.9
                float inputs:metallic = 0
                token outputs:surface
            }
        }

        def Material "Mud" (prepend apiSchemas = ["PhysicsMaterialAPI"])
        {
            float physics:staticFriction = 0.35
            float physics:dynamicFriction = 0.22
            float physics:restitution = 0.0
            token outputs:surface.connect = </World/Materials/Mud/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.25, 0.22, 0.14)
                float inputs:roughness = 0.9
                float inputs:metallic = 0
                token outputs:surface
            }
        }

        def Material "Riverbed" (prepend apiSchemas = ["PhysicsMaterialAPI"])
        {
            float physics:staticFriction = 0.6
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0.0
            token outputs:surface.connect = </World/Materials/Riverbed/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.33, 0.3, 0.21)
                float inputs:roughness = 0.9
                float inputs:metallic = 0
                token outputs:surface
            }
        }
 }
    def Xform "Ground" { 
        def Mesh "Grass" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "MaterialBindingAPI"])
        {
            bool physics:collisionEnabled = true
            token physics:approximation = "none"
            rel material:binding = </World/Materials/Grass>
            rel material:binding:physics = </World/Materials/Grass>
            point3f[] points = [(-10, -3, -0.3), (-6, -3, -0.3), (-6, 3, -0.3), (-10, 3, -0.3), (-10, -3, 0), (-6, -3, 0), (-6, 3, 0), (-10, 3, 0)]
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0,3,2,1, 4,5,6,7, 0,1,5,4, 1,2,6,5, 2,3,7,6, 3,0,4,7]
