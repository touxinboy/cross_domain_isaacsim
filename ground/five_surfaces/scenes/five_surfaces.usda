        }

        def Mesh "Mud" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "MaterialBindingAPI"])
        {
            bool physics:collisionEnabled = true
            token physics:approximation = "none"
            rel material:binding = </World/Materials/Mud>
            rel material:binding:physics = </World/Materials/Mud>
            point3f[] points = [(2, -3, -0.3), (6, -3, -0.3), (6, 3, -0.3), (2, 3, -0.3), (2, -3, 0), (6, -3, 0), (6, 3, 0), (2, 3, 0)]
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0,3,2,1, 4,5,6,7, 0,1,5,4, 1,2,6,5, 2,3,7,6, 3,0,4,7]
            uniform token subdivisionScheme = "none"
        }

        def Mesh "Riverbed" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "MaterialBindingAPI"])
        {
            bool physics:collisionEnabled = true
            token physics:approximation = "none"
            rel material:binding = </World/Materials/Riverbed>
            rel material:binding:physics = </World/Materials/Riverbed>
            point3f[] points = [(6, -3, -0.3), (10, -3, -0.3), (10, 3, -0.3), (6, 3, -0.3), (6, -3, 0), (10, -3, 0), (10, 3, 0), (6, 3, 0)]
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0,3,2,1, 4,5,6,7, 0,1,5,4, 1,2,6,5, 2,3,7,6, 3,0,4,7]
            uniform token subdivisionScheme = "none"
